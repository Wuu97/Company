generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  factories Factory[]
  orders    SoOrder[]
}

model AppUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         AppRole  @default(OPERATOR)
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  sessions     AppSession[]
  credentialChanges DataSourceCredential[] @relation("CredentialChangedBy")
  notifications AppNotification[]
}

model AppNotification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  href      String?
  kind      String
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@unique([userId, dedupeKey])
}

model AppSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  sourceKey String
  failedAt  DateTime @default(now())

  @@index([email, failedAt])
  @@index([sourceKey, failedAt])
}

model DataSourceCredential {
  id             String   @id @default(cuid())
  terminal       String   @unique
  username       String
  ciphertext     String
  iv             String
  authTag        String
  changedById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  changedBy      AppUser  @relation("CredentialChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  testRuns       EtbCredentialTestRun[]
}

model EtbCredentialTestRun {
  id                   String                  @id @default(cuid())
  terminal             String
  credentialId         String
  status               EtbCredentialTestStatus @default(PENDING)
  errorMessage         String?
  screenshotStorageKey String?
  startedAt            DateTime?
  finishedAt           DateTime?
  createdAt            DateTime                @default(now())
  credential           DataSourceCredential    @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([terminal, createdAt])
}

model Factory {
  id           String        @id @default(cuid())
  customerId   String
  name         String
  address      String
  contactName  String?
  contactPhone String?
  customer     Customer      @relation(fields: [customerId], references: [id])
  plans        LoadingPlan[]

  @@unique([customerId, name])
}

model Sailing {
  id         String    @id @default(cuid())
  terminal   String
  carrier    String
  vesselName String
  voyage     String
  loadPort   String?
  adoptedEtbAt DateTime?
  adoptedEtbSource String?
  adoptedEtbAtConfirmedAt DateTime?
  pendingEtbAt DateTime?
  pendingEtbSource String?
  pendingEtbObservedAt DateTime?
  etbNeedsReview Boolean @default(false)
  orders     SoOrder[]
  observations SailingObservation[]

  @@unique([terminal, carrier, vesselName, voyage])
}

model SailingObservation {
  id                 String               @id @default(cuid())
  sailingId          String
  etbAt              DateTime
  source             String
  sourceUrl          String?
  screenshotStorageKey String?
  observedAt         DateTime             @default(now())
  status             EtbObservationStatus @default(PENDING)
  reviewedAt         DateTime?
  reviewNote         String?
  sailing            Sailing              @relation(fields: [sailingId], references: [id], onDelete: Cascade)

  @@index([sailingId, observedAt])
  @@index([status, observedAt])
}

model EtbQueryRun {
  id           String            @id @default(cuid())
  terminal     String
  source       String
  scheduledFor DateTime
  startedAt    DateTime?
  finishedAt   DateTime?
  status       EtbQueryRunStatus @default(PENDING)
  sessionState EtbSessionState @default(NOT_REQUIRED)
  resultCount  Int               @default(0)
  errorMessage String?
  handoffReason String?
  screenshotStorageKey String?
  retryAfter   DateTime?
  manualHandledAt DateTime?
  createdAt    DateTime          @default(now())
  unmatchedResults EtbUnmatchedResult[]

  @@index([terminal, scheduledFor])
  @@index([status, createdAt])
}

// Raw rows which the source returned but could not safely attach to a sailing.
// They are intentionally retained for an operator to review instead of turning a
// technically successful scrape into an apparently successful business update.
model EtbUnmatchedResult {
  id           String      @id @default(cuid())
  queryRunId   String
  carrier      String
  vesselName   String
  voyage       String
  etbAt        DateTime
  sourceUrl    String?
  screenshotStorageKey String?
  matchNote    String?
  resolvedAt   DateTime?
  resolvedSailingId String?
  createdAt    DateTime    @default(now())
  queryRun     EtbQueryRun @relation(fields: [queryRunId], references: [id], onDelete: Cascade)

  @@index([queryRunId, createdAt])
  @@index([resolvedAt, createdAt])
}

model SoOrder {
  id                  String                 @id @default(cuid())
  customerId          String?
  sailingId           String?
  soNumber            String
  carrier             String
  parseStatus         ParseStatus            @default(PENDING)
  status              OrderStatus            @default(PENDING_REVIEW)
  createdAt           DateTime               @default(now())
  siCutoffText        String?
  siCutoffSource      String?
  siCutoffOriginalText String?
  siCutoffEstimatedFromText String?
  openingText         String?
  vgmCutoffText       String?
  portCutoffText      String?
  etbNeedsReview      Boolean                @default(false)
  etbObservedAt       DateTime?
  etbSource           String?
  etbText             String?
  customerReference   String?
  cutoffText          String?
  dischargePort       String?
  emptyPickupLocation String?
  etaText             String?
  etdText             String?
  fullReturnLocation  String?
  loadPort            String?
  transportMode       String?
  vesselName          String?
  voyage              String?
  cargoItems          CargoItem[]
  containers          ContainerUnit[]
  confirmations       CustomerConfirmation[]
  plans               LoadingPlan[]
  files               SoFileVersion[]
  customer            Customer?              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sailing             Sailing?               @relation(fields: [sailingId], references: [id])
  versionChanges      SoVersionChange[]
  contactTasks        CustomerContactTask[]

  @@index([customerId, carrier, soNumber])
}

model SoFileVersion {
  id              String           @id @default(cuid())
  soOrderId       String?
  storageKey      String           @unique
  originalName    String
  sha256          String           @unique
  version         Int
  parseStatus     ParseStatus      @default(PENDING)
  processingStartedAt DateTime?
  processingToken String?
  rawExtraction   Json?
  correctedFields Json?
  createdAt       DateTime         @default(now())
  soOrder         SoOrder?         @relation(fields: [soOrderId], references: [id], onDelete: Restrict)
  versionChange   SoVersionChange?

  @@unique([soOrderId, version])
  @@index([parseStatus, processingStartedAt])
}

model CargoItem {
  id           String   @id @default(cuid())
  soOrderId    String
  description  String
  packagesText String?
  weightText   String?
  volumeText   String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  soOrder      SoOrder  @relation(fields: [soOrderId], references: [id])

  @@index([soOrderId, sortOrder])
}

model SoVersionChange {
  id              String        @id @default(cuid())
  soOrderId       String
  soFileVersionId String        @unique
  changes         Json
  status          String        @default("PENDING")
  createdAt       DateTime      @default(now())
  confirmedAt     DateTime?
  soFileVersion   SoFileVersion @relation(fields: [soFileVersionId], references: [id])
  soOrder         SoOrder       @relation(fields: [soOrderId], references: [id])
}

model ContainerUnit {
  id            String            @id @default(cuid())
  internalCode  String            @unique
  soOrderId     String
  containerNo   String?
  containerType String
  active        Boolean           @default(true)
  soOrder       SoOrder           @relation(fields: [soOrderId], references: [id])
  planItems     LoadingPlanItem[]

  @@index([containerNo])
}

model CustomerConfirmation {
  id            String             @id @default(cuid())
  soOrderId     String
  quantity      Int
  status        ConfirmationStatus @default(PENDING)
  confirmedDate DateTime?
  expectedLoadingAt DateTime?
  note          String?
  createdAt     DateTime           @default(now())
  soOrder       SoOrder            @relation(fields: [soOrderId], references: [id])
  loadingPlans  LoadingPlan[]
}

model LoadingPlan {
  id             String              @id @default(cuid())
  soOrderId      String
  factoryId      String
  scheduledAt    DateTime
  status         PlanStatus          @default(DRAFT)
  replacesPlanId String?
  reason         String?
  customerConfirmationId String?
  createdAt      DateTime            @default(now())
  factory        Factory             @relation(fields: [factoryId], references: [id])
  soOrder        SoOrder             @relation(fields: [soOrderId], references: [id])
  changesFrom    LoadingPlanChange[] @relation("ChangeFrom")
  changesTo      LoadingPlanChange[] @relation("ChangeTo")
  items          LoadingPlanItem[]
  customerConfirmation CustomerConfirmation? @relation(fields: [customerConfirmationId], references: [id])
  transportTask  TransportTask?

  @@index([soOrderId, status])
}

model TransportTask {
  id             String          @id @default(cuid())
  loadingPlanId  String          @unique
  status         TransportStatus @default(PLANNED)
  scheduledAt    DateTime
  dispatchedAt   DateTime?
  completedAt    DateTime?
  primaryCostText String?
  note           String?
  etbImpactNeedsReview Boolean @default(false)
  etbImpactResolvedAt DateTime?
  etbImpactResolutionNote String?
  createdAt      DateTime        @default(now())
  loadingPlan    LoadingPlan     @relation(fields: [loadingPlanId], references: [id])
  legs           TransportLeg[]

  @@index([status, scheduledAt])
}

model TransportLeg {
  id              String          @id @default(cuid())
  transportTaskId String
  sequence        Int
  vehicleNo       String?
  fleetOwnerName  String?
  driverName      String?
  driverPhone     String?
  pickupTerminal  String?
  factoryLocation String?
  returnTerminal  String?
  plannedPickupAt DateTime?
  actualPickupAt  DateTime?
  actualFactoryArrivedAt DateTime?
  actualReturnAt  DateTime?
  trailerSwapNote String?
  overnightNote   String?
  exceptionNote   String?
  status          TransportStatus @default(PLANNED)
  note            String?
  transportTask   TransportTask  @relation(fields: [transportTaskId], references: [id], onDelete: Cascade)

  @@unique([transportTaskId, sequence])
}

model LoadingPlanChange {
  id         String      @id @default(cuid())
  fromPlanId String
  toPlanId   String
  reason     String
  createdAt  DateTime    @default(now())
  fromPlan   LoadingPlan @relation("ChangeFrom", fields: [fromPlanId], references: [id])
  toPlan     LoadingPlan @relation("ChangeTo", fields: [toPlanId], references: [id])

  @@unique([fromPlanId, toPlanId])
}

model LoadingPlanItem {
  id              String        @id @default(cuid())
  loadingPlanId   String
  containerUnitId String
  active          Boolean       @default(true)
  containerUnit   ContainerUnit @relation(fields: [containerUnitId], references: [id])
  loadingPlan     LoadingPlan   @relation(fields: [loadingPlanId], references: [id])

  @@unique([loadingPlanId, containerUnitId])
}

model OperationLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
  actorUserId String?
  actorName   String?
  actorRole   AppRole?
}

model CustomerContactTask {
  id          String            @id @default(cuid())
  soOrderId   String
  dueAt       DateTime
  status      ContactTaskStatus @default(OPEN)
  note        String?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  soOrder     SoOrder           @relation(fields: [soOrderId], references: [id], onDelete: Cascade)

  @@unique([soOrderId, dueAt])
  @@index([status, dueAt])
}

enum ParseStatus {
  PENDING
  PROCESSING
  PARSED
  FAILED
  VERIFIED
}

enum AppRole {
  ADMIN
  OPERATOR
}

enum EtbCredentialTestStatus {
  PENDING
  RUNNING
  SUCCEEDED
  AWAITING_MANUAL
  FAILED
}

enum OrderStatus {
  PENDING_REVIEW
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EtbObservationStatus {
  PENDING
  ADOPTED
  IGNORED
  SUPERSEDED
}

enum EtbQueryRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  AWAITING_MANUAL
}

enum EtbSessionState {
  NOT_REQUIRED
  ACTIVE
  EXPIRED
  ROBOT_VERIFICATION_REQUIRED
  MANUAL_HANDOFF_REQUIRED
}

enum TransportStatus {
  PLANNED
  DISPATCHED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum ContactTaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum PlanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  REPLACED
  COMPLETED
}

enum ConfirmationStatus {
  PENDING
  PARTIAL
  CONFIRMED
  DEFERRED
  CANCELLED
}
